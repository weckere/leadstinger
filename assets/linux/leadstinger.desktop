[Desktop Entry]
Type=Application
Name=LeadStinger
GenericName=Soundboard
Comment=Fire sound clips live from a grid of tiles or a cue list
Exec=leadstinger %u
Icon=leadstinger
Terminal=false
Categories=AudioVideo;Audio;Player;
Keywords=soundboard;stinger;cue;clips;sound effects;podcast;
MimeType=x-scheme-handler/leadstinger;application/x-leadstinger-set;
StartupWMClass=leadstinger
StartupNotify=true
